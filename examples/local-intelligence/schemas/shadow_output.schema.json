{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-ops-li-shadow-output-v1",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "may_override",
    "source_fingerprint",
    "identity",
    "boundaries",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "career-ops-li-shadow-output-v1"
    },
    "authority": {
      "const": "ADVISORY_ONLY"
    },
    "may_override": {
      "const": false
    },
    "source_fingerprint": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "properties": {
        "employer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "requisition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_posting_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observations": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "boundaries": {
      "type": "array"
    },
    "requirements": {
      "type": "array"
    },
    "retrieval_context": {
      "type": "array"
    },
    "model_metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
